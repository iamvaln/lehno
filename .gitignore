
# worktrees d'implémentation
.worktrees/
node_modules/
dist/
.next/
.turbo/
.env
.env.*
!.env.example
*.tsbuildinfo

# Les projets natifs, engendrés par `expo prebuild` depuis app.json et les
# modules installés. Ils se refont d'une commande : les versionner obligerait à
# régler les conflits d'un fichier de projet Xcode, ce que personne ne souhaite.
apps/mobile/ios/
apps/mobile/android/

# L'état du serveur de développement Expo. Le typecheck tient sans lui : la glob
# de tsconfig ne désigne aucun fichier en particulier. `expo-env.d.ts` est ignoré
# par apps/mobile/.gitignore, que l'outil engendre et resynchronise lui-même.
.expo/
.DS_Store

# ressources locales, hors dépôt
# Les specs et la marque sont versionnées, mais pas leurs dérivés :
# rendus empaquetés, PDF, captures et archives se régénèrent depuis la source
# et pèsent 27 des 29 Mo. Les garder ferait grossir l'historique à chaque
# itération, sans rien apporter qu'on ne puisse reproduire.
specs/*.pdf
specs/*.zip
specs/*.png
specs/Lehno Landing*.html
specs/Lehno Identite visuelle*.html
images/exports/.fraunces-subset.b64.txt
