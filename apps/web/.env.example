# Adresse de l'API, lue au rendu serveur pour /v1/public/config.
# Absente ou injoignable, la landing s'affiche avec ses valeurs de repli.
API_URL=http://localhost:3000

# Même adresse, mais lue par le navigateur : le formulaire de liste d'attente
# poste sur /v1/public/waitlist depuis le poste du visiteur.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Le drapeau de lancement. Absent ou différent de « 1 », la landing est en
# pré-lancement : elle capture une adresse. À « 1 », elle montre les badges
# App Store et Google Play.
NEXT_PUBLIC_LANCEMENT=0
