{
  "cli": {
    "version": ">= 23.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3001",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "LEHNO_APP_ENV": "dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.lehno.io",
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "LEHNO_APP_ENV": "staging"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.lehno.io",
        "LEHNO_APP_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
