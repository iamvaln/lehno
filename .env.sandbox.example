# La sandbox — gabarit. Le vrai fichier vit sur le VPS, dans
# $HOME/lehno-sandbox/.env.sandbox, et n'est jamais commité.
#
# CE QUI LE DISTINGUE DE LA PRODUCTION, et pourquoi chaque écart compte :
#
# STACK sépare les routeurs Traefik. Deux piles sous le même nom se
# disputeraient les mêmes routeurs, et la dernière déployée emporterait les
# domaines de l'autre — la production pointerait sur la sandbox.
# SANS CETTE LIGNE, RIEN NE DÉMARRE — et le message ne le dit pas franchement.
# `--env-file` sur la ligne de commande ne gouverne que l'INTERPOLATION des
# `${…}` du compose ; les services, eux, déclarent
# `env_file: ${ENV_FILE:-.env.production}`. Sans `ENV_FILE`, ils réclament donc
# `.env.production`, qui n'existe pas ici, et le déploiement meurt sur
# « env file … not found » après avoir téléchargé toutes les images.
ENV_FILE=.env.sandbox

STACK=lehno-sandbox

# Les domaines. Trois enregistrements DNS de type A vers le VPS, EN « DNS only »
# le temps que Let's Encrypt réponde au défi HTTP : derrière le nuage orange de
# Cloudflare, la validation échoue.
API_DOMAIN=api.sandbox.lehno.io
WEB_DOMAIN=sandbox.lehno.io
# (le panneau se sert de admin.${WEB_DOMAIN}, sans variable propre)

# Ce que les paquets clients portent DÉJÀ gravé depuis le build — répété ici
# pour ce qui se lit à l'exécution, côté serveur.
API_URL=https://api.sandbox.lehno.io
PUBLIC_WEB_URL=https://sandbox.lehno.io
NEXT_PUBLIC_API_URL=https://api.sandbox.lehno.io
VITE_API_URL=https://api.sandbox.lehno.io/v1
NEXT_PUBLIC_LANCEMENT=0

# `le-dns`, COMME LA PRODUCTION — et ce n'est pas un détail de confort.
#
# Traefik porte deux résolveurs : `le` valide par TLS-ALPN-01, `le-dns` par
# DNS-01. Derrière le mandataire Cloudflare, Cloudflare TERMINE le TLS : la
# validation TLS-ALPN n'atteint jamais l'origine. Avec `le`, il faut donc
# laisser les enregistrements en « DNS only », ce qui EXPOSE l'IP du VPS —
# Cloudflare le signale d'ailleurs dans le tableau de bord.
#
# `le` avait été choisi ici sans regarder ce que la production employait. Le
# certificat de `sandbox.lehno.io` a échoué, l'IP est restée exposée, et le
# renouvellement de novembre aurait échoué à son tour. Trois conséquences pour
# une ligne recopiée de travers.
CERT_RESOLVER=le-dns

# SA PROPRE BASE, et pas une copie de la production. Une sandbox qui porte
# les vraies données est une fuite : on y essaie des gestes destructeurs, on y
# ouvre des accès larges, et les adresses e-mail qui s'y trouvent sont réelles.
POSTGRES_USER=lehno_sandbox
POSTGRES_PASSWORD=<à engendrer>
POSTGRES_DB=lehno_sandbox
DATABASE_URL=postgresql://lehno_sandbox:<le même>@db:5432/lehno_sandbox?schema=public

# DES SECRETS DISTINCTS DE LA PRODUCTION. Les partager ferait qu'un jeton
# émis par la sandbox ouvrirait la vraie application — c'est le genre de
# raccourci qu'on prend « en attendant » et qui ne se défait jamais.
JWT_SECRET=<à engendrer : openssl rand -hex 32>
ADMIN_JWT_SECRET=<à engendrer>
OTP_PEPPER=<à engendrer>

# L'envoi de courrier. Une sandbox écrit à de VRAIES adresses s'il est
# configuré comme la production : mieux vaut une clé de test, ou rien.
RESEND_API_KEY=<clé de test, ou vide>
RESEND_FROM=Lehno Sandbox <no-reply@sandbox.lehno.io>
CONTACT_TO_EMAIL=<votre adresse>

# Les notifications. Vide = pas de push, ce qui convient à une sandbox.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# NI R2 NI SAUVEGARDE : le service `backup` n'est pas déployé ici. Les données
# de la sandbox sont jetables par définition, et un dump que personne ne
# relira ne vaut pas un bucket de plus à tenir.
