#!/bin/bash
# Quick "what's in the bucket" command. Mostly used as a sanity check after
# changing R2 creds — if list returns nothing or 403s, the next backup
# would silently fail until someone looks.
set -euo pipefail

: "${BACKUP_R2_ENDPOINT:?BACKUP_R2_ENDPOINT is required}"
: "${BACKUP_R2_BUCKET:?BACKUP_R2_BUCKET is required}"

PREFIX=${BACKUP_R2_PREFIX:-backups}

echo "s3://${BACKUP_R2_BUCKET}/${PREFIX}/"
aws s3 ls "s3://${BACKUP_R2_BUCKET}/${PREFIX}/" \
  --endpoint-url "${BACKUP_R2_ENDPOINT}" \
  --human-readable \
  --summarize
