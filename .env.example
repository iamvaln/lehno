
# Base de données — 5433 côté hôte, pour éviter un PostgreSQL déjà installé
DATABASE_URL=postgresql://lehno:lehno@localhost:5433/lehno

# Secrets — générer avec : openssl rand -base64 32
# Le serveur refuse de démarrer s'ils manquent : mieux vaut ne pas démarrer
# que hacher sans clé.
OTP_PEPPER=
JWT_SECRET=


SENTRY_DSN=
LEHNO_LOG_OTP=

# Envoi de courriel. Sans ces deux valeurs ET sans LEHNO_MAIL_CONSOLE,
# le serveur refuse de démarrer.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
RESEND_API_KEY=
RESEND_FROM="Lehno <no-reply@lehno.app>"


# Accepte explicitement l'adaptateur de console en développement : il affiche
# le message dans le journal, code à usage unique compris. Adhésion volontaire
# — un environnement muet ne journalise jamais de secret.
LEHNO_MAIL_CONSOLE=

# Connexion externe. Vérifiées à l'usage, pas au démarrage.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Port d'écoute (3000 par défaut)
PORT=

